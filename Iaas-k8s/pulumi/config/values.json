{
  "companyName": "mycompany",
  "global": {
    "environment": "production",
    "region": "us-central1"
  },
  "imagePullSecrets": [],
  "nameOverride": "",
  "fullnameOverride": "",
  "rafikiAuth": {
    "enabled": true,
    "name": "rafiki-auth",
    "replicaCount": 3,
    "image": {
      "repository": "ghcr.io/interledger/rafiki-auth",
      "tag": "latest",
      "pullPolicy": "Always"
    },
    "ports": {
      "main": 3006,
      "grant": 3009,
      "admin": 3001
    },
    "service": {
      "type": "ClusterIP",
      "ports": {
        "main": 3006,
        "grant": 3009,
        "admin": 3001
      }
    },
    "secrets": {
      "name": "rafiki-auth-secrets"
    },
    "hpa": {
      "enabled": true,
      "minReplicas": 3,
      "maxReplicas": 8,
      "targetCPUUtilizationPercentage": 70,
      "targetMemoryUtilizationPercentage": 75
    }
  },
  "rafikiBackend": {
    "enabled": true,
    "name": "rafiki-backend",
    "replicaCount": 2,
    "image": {
      "repository": "ghcr.io/interledger/rafiki-backend",
      "tag": "latest",
      "pullPolicy": "Always"
    },
    "ports": {
      "openPayments": 80,
      "graphql": 3001,
      "connector": 3002,
      "admin": 3003,
      "autopeering": 3004
    },
    "service": {
      "type": "ClusterIP",
      "ports": {
        "openPayments": 80,
        "graphql": 3001,
        "connector": 3002,
        "admin": 3003,
        "autopeering": 3004
      }
    },
    "secrets": {
      "name": "rafiki-backend-secrets"
    },
    "hpa": {
      "enabled": true,
      "minReplicas": 2,
      "maxReplicas": 6,
      "targetCPUUtilizationPercentage": 75,
      "targetMemoryUtilizationPercentage": 80
    }
  },
  "nginx": {
    "enabled": true,
    "name": "nginx",
    "replicaCount": 2,
    "image": {
      "repository": "nginx",
      "tag": "latest",
      "pullPolicy": "IfNotPresent"
    },
    "ports": {
      "http": 80
    },
    "service": {
      "type": "ClusterIP",
      "port": 80
    },
    "hpa": {
      "enabled": true,
      "minReplicas": 2,
      "maxReplicas": 10,
      "targetCPUUtilizationPercentage": 80
    },
    "configMap": {
      "name": "nginx-config"
    },
    "config": {
      "serverNameIlp": "ilp-k8s-sandbox.chimoney.com",
      "serverNameAuth": "auth-ilp-k8s-sandbox.chimoney.io",
      "graphqlAllowedIps": [
        "35.160.120.126",
        "44.233.151.27",
        "34.211.200.85",
        "34.66.77.227"
      ]
    }
  },
  "redis": {
    "enabled": true,
    "name": "redis",
    "replicaCount": 2,
    "image": {
      "repository": "redis",
      "tag": "7",
      "pullPolicy": "IfNotPresent"
    },
    "ports": {
      "redis": 6379
    },
    "service": {
      "type": "ClusterIP",
      "port": 6379
    }
  },
  "ingress": {
    "enabled": true,
    "name": "rafiki-ingress",
    "className": "gce",
    "annotations": {
      "kubernetes.io/ingress.class": "gce",
      "kubernetes.io/ingress.global-static-ip-name": "rafiki-global-ip",
      "kubernetes.io/ingress.allow-http": "true",
      "cloud.google.com/neg": "{\"ingress\": true}",
      "cloud.google.com/backend-config": "{\"default\": \"rafiki-backend-config\"}"
    },
    "hosts": {
      "ilp": {
        "host": "ilp-k8s-sandbox.chimoney.com",
        "paths": [
          {
            "path": "/",
            "pathType": "Prefix",
            "serviceNameSuffix": "nginx",
            "servicePort": 80
          }
        ]
      },
      "auth": {
        "host": "auth-ilp-k8s-sandbox.chimoney.io",
        "paths": [
          {
            "path": "/",
            "pathType": "Prefix",
            "serviceNameSuffix": "nginx",
            "servicePort": 80
          }
        ]
      }
    }
  },
  "gcp": {
    "backendConfig": {
      "enabled": true,
      "name": "rafiki-backend-config",
      "healthCheck": {
        "checkIntervalSec": 10,
        "timeoutSec": 5,
        "healthyThreshold": 1,
        "unhealthyThreshold": 3,
        "type": "HTTP",
        "requestPath": "/healthz",
        "port": 80
      }
    }
  }
}
