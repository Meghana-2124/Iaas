{
  "namespace": "client-a-prod",
  "deploymentType": "shared",
  "companyName": "client-a",
  "networkPolicy": {
    "enabled": true,
    "allowIngressFrom": [{ "name": "ingress-nginx" }, { "name": "monitoring" }],
    "allowEgressTo": [{ "cidr": "10.0.0.0/8" }, { "cidr": "172.16.0.0/12" }],
    "allowEgressPorts": [
      { "protocol": "TCP", "port": 443 },
      { "protocol": "TCP", "port": 5432 },
      { "protocol": "TCP", "port": 6379 }
    ]
  },
  "rafikiAuth": {
    "enabled": true,
    "replicaCount": 2,
    "image": {
      "repository": "interledger/rafiki-auth",
      "tag": "latest",
      "pullPolicy": "IfNotPresent"
    },
    "ports": {
      "main": 3006,
      "grant": 3007,
      "admin": 3008
    },
    "service": {
      "type": "ClusterIP",
      "ports": {
        "main": 3006,
        "grant": 3007,
        "admin": 3008
      }
    },
    "resources": {
      "requests": {
        "cpu": "100m",
        "memory": "128Mi"
      },
      "limits": {
        "cpu": "500m",
        "memory": "512Mi"
      }
    }
  },
  "rafikiBackend": {
    "enabled": true,
    "replicaCount": 3,
    "image": {
      "repository": "interledger/rafiki-backend",
      "tag": "latest",
      "pullPolicy": "IfNotPresent"
    },
    "ports": {
      "openPayments": 3000,
      "admin": 3001,
      "webhook": 3002
    },
    "service": {
      "type": "ClusterIP",
      "ports": {
        "openPayments": 3000,
        "admin": 3001,
        "webhook": 3002
      }
    },
    "resources": {
      "requests": {
        "cpu": "200m",
        "memory": "256Mi"
      },
      "limits": {
        "cpu": "1000m",
        "memory": "1Gi"
      }
    }
  },
  "ingress": {
    "enabled": true,
    "className": "nginx",
    "name": "client-a-ingress",
    "hosts": {
      "ilp": {
        "host": "ilp.client-a.example.com",
        "paths": [
          {
            "path": "/",
            "pathType": "Prefix",
            "serviceNameSuffix": "rafiki-backend",
            "servicePort": 3000
          }
        ]
      },
      "auth": {
        "host": "auth.client-a.example.com",
        "paths": [
          {
            "path": "/",
            "pathType": "Prefix",
            "serviceNameSuffix": "rafiki-auth",
            "servicePort": 3006
          }
        ]
      }
    },
    "tls": [
      {
        "secretName": "client-a-tls",
        "hosts": ["ilp.client-a.example.com", "auth.client-a.example.com"]
      }
    ]
  }
}
