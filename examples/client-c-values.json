{
  "deploymentType": "dedicated",
  "companyName": "client-c",
  "rafikiAuth": {
    "enabled": true,
    "replicaCount": 3,
    "image": {
      "repository": "interledger/rafiki-auth",
      "tag": "latest",
      "pullPolicy": "IfNotPresent"
    },
    "ports": {
      "main": 3006,
      "grant": 3007,
      "admin": 3008
    },
    "service": {
      "type": "ClusterIP",
      "ports": {
        "main": 3006,
        "grant": 3007,
        "admin": 3008
      }
    },
    "resources": {
      "requests": {
        "cpu": "200m",
        "memory": "256Mi"
      },
      "limits": {
        "cpu": "1000m",
        "memory": "1Gi"
      }
    }
  },
  "rafikiBackend": {
    "enabled": true,
    "replicaCount": 5,
    "image": {
      "repository": "interledger/rafiki-backend",
      "tag": "latest",
      "pullPolicy": "IfNotPresent"
    },
    "ports": {
      "openPayments": 3000,
      "admin": 3001,
      "webhook": 3002
    },
    "service": {
      "type": "ClusterIP",
      "ports": {
        "openPayments": 3000,
        "admin": 3001,
        "webhook": 3002
      }
    },
    "resources": {
      "requests": {
        "cpu": "500m",
        "memory": "512Mi"
      },
      "limits": {
        "cpu": "2000m",
        "memory": "2Gi"
      }
    }
  },
  "ingress": {
    "enabled": true,
    "className": "nginx",
    "name": "client-c-ingress",
    "hosts": {
      "ilp": {
        "host": "ilp.client-c.example.com",
        "paths": [
          {
            "path": "/",
            "pathType": "Prefix",
            "serviceNameSuffix": "rafiki-backend",
            "servicePort": 3000
          }
        ]
      },
      "auth": {
        "host": "auth.client-c.example.com",
        "paths": [
          {
            "path": "/",
            "pathType": "Prefix",
            "serviceNameSuffix": "rafiki-auth",
            "servicePort": 3006
          }
        ]
      }
    },
    "tls": [
      {
        "secretName": "client-c-tls",
        "hosts": ["ilp.client-c.example.com", "auth.client-c.example.com"]
      }
    ]
  },
  "postgres": {
    "enabled": true,
    "replicaCount": 3,
    "persistence": {
      "enabled": true,
      "size": "100Gi",
      "storageClass": "gp3"
    },
    "resources": {
      "requests": {
        "cpu": "1000m",
        "memory": "2Gi"
      },
      "limits": {
        "cpu": "4000m",
        "memory": "8Gi"
      }
    }
  },
  "redis": {
    "enabled": true,
    "replicaCount": 3,
    "persistence": {
      "enabled": true,
      "size": "20Gi",
      "storageClass": "gp3"
    },
    "resources": {
      "requests": {
        "cpu": "500m",
        "memory": "1Gi"
      },
      "limits": {
        "cpu": "2000m",
        "memory": "4Gi"
      }
    }
  }
}
